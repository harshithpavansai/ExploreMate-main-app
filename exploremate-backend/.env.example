NODE_ENV=development
PORT=5000
API_PREFIX=/api/v1
CLIENT_URL=*

# Local development uses an in-memory database by default.
# Set DB_MODE=postgres when you are ready to use PostgreSQL.
# DB_MODE=postgres
# DATABASE_URL=postgres://postgres:postgres@localhost:5432/exploremate
# PG_SSL=false

JWT_SECRET=change-this-dev-access-secret
JWT_REFRESH_SECRET=change-this-dev-refresh-secret
JWT_EXPIRES_IN=1d
JWT_REFRESH_EXPIRES_IN=30d

# Optional integrations. When omitted, deterministic mock responses are used.
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
# GOOGLE_MAPS_API_KEY=
# OPENWEATHER_API_KEY=
# GOOGLE_TRANSLATE_API_KEY=
# GOOGLE_TTS_API_KEY=
